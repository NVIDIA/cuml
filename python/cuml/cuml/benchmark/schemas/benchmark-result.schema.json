{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rapids.ai/schemas/benchmark-result.schema.json",
  "title": "Benchmark Observation Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "results"],
  "properties": {
    "schema_version": { "const": 2 },
    "run": { "$ref": "#/$defs/run" },
    "results": { "type": "array", "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "jsonObject": { "type": "object", "additionalProperties": true },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
      },
      "additionalProperties": true
    },
    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["repository", "revision", "dirty"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "methodology", "command", "system", "software", "extensions"],
      "properties": {
        "id": { "type": "string", "format": "uri", "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$" },
        "created_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
        "completed_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
        "methodology": {
          "type": "object", "additionalProperties": false, "required": ["id"],
          "properties": { "id": { "type": "string", "minLength": 1 } }
        },
        "command": {
          "type": "object", "additionalProperties": false, "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string" }
          }
        },
        "system": {
          "type": "object", "additionalProperties": false, "required": ["label", "components"],
          "properties": {
            "label": { "type": "string" },
            "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
          }
        },
        "software": {
          "type": "object", "additionalProperties": false, "required": ["runtimes", "packages"],
          "properties": {
            "runtimes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runtime" } },
            "packages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/package" } }
          }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "count", "attributes"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "attributes": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "build", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "case_label", "algorithm", "dataset", "operation", "input", "parameters", "implementation", "outcome", "observations", "extensions"],
      "properties": {
        "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "case_label": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 },
        "dataset": { "$ref": "#/$defs/dataset" },
        "operation": { "$ref": "#/$defs/operation" },
        "input": {
          "type": "object", "additionalProperties": false,
          "required": ["dimensions", "data_type", "selection", "attributes"],
          "properties": {
            "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension" } },
            "data_type": { "type": "string", "minLength": 1 },
            "selection": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "attributes": { "$ref": "#/$defs/jsonObject" }
          }
        },
        "parameters": {
          "type": "object", "additionalProperties": false, "required": ["declared", "effective"],
          "properties": { "declared": { "$ref": "#/$defs/jsonObject" }, "effective": { "$ref": "#/$defs/jsonObject" } }
        },
        "implementation": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "build", "source"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "build": { "type": ["string", "null"] },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "outcome": { "$ref": "#/$defs/resultOutcome" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "properties": { "status": { "const": "success" } }, "required": ["status"] } } },
          "then": {
            "properties": {
              "outcome": { "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["last_phase"] }, { "required": ["error"] }] } },
              "observations": {
                "contains": { "properties": { "role": { "const": "measurement" }, "outcome": { "properties": { "status": { "const": "success" } }, "required": ["status"] } }, "required": ["role", "outcome"] },
                "items": { "properties": { "outcome": { "properties": { "status": { "const": "success" } }, "required": ["status"] } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "properties": { "status": { "const": "skipped" } }, "required": ["status"] } } },
          "then": { "properties": { "observations": { "maxItems": 0 } } }
        }
      ]
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "parameters", "generator", "fingerprint", "random_seed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["generated", "external"] },
        "parameters": { "$ref": "#/$defs/jsonObject" },
        "generator": { "type": ["string", "null"], "minLength": 1 },
        "fingerprint": { "type": ["string", "null"], "minLength": 1 },
        "random_seed": { "type": ["integer", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "generated" } }, "required": ["kind"] }, "then": { "properties": { "generator": { "type": "string", "minLength": 1 }, "random_seed": { "type": "integer" } } } },
        { "if": { "properties": { "kind": { "const": "external" } }, "required": ["kind"] }, "then": { "properties": { "fingerprint": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lifecycle"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "minLength": 1 }
      }
    },
    "dimension": {
      "type": "object", "additionalProperties": false, "required": ["name", "size"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "size": { "type": "integer", "minimum": 0 } }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["type", "message"],
      "properties": { "type": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }
    },
    "resultOutcome": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": { "enum": ["success", "failed", "skipped"] },
        "reason": { "type": "string", "minLength": 1 },
        "last_phase": { "type": "string", "minLength": 1 },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "skipped" } }, "required": ["status"] }, "then": { "required": ["reason"] } },
        { "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "then": { "anyOf": [{ "required": ["reason"] }, { "required": ["last_phase"] }, { "required": ["error"] }] } }
      ]
    },
    "observationOutcome": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": { "enum": ["success", "failed"] },
        "reason": { "type": "string", "minLength": 1 },
        "last_phase": { "type": "string", "minLength": 1 },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] }, "then": { "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["last_phase"] }, { "required": ["error"] }] } } },
        { "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "then": { "anyOf": [{ "required": ["reason"] }, { "required": ["last_phase"] }, { "required": ["error"] }] } }
      ]
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sequence", "role", "outcome", "timings", "metrics", "extensions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["warmup", "measurement"] },
        "outcome": { "$ref": "#/$defs/observationOutcome" },
        "timings": { "type": "array", "items": { "$ref": "#/$defs/timing" } },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "properties": { "status": { "const": "success" } }, "required": ["status"] } } },
          "then": { "properties": { "timings": { "minItems": 1 } } }
        }
      ]
    },
    "timing": {
      "type": "object", "additionalProperties": false, "required": ["name", "value", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["s", "ms", "us", "ns"] }
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false, "required": ["name", "value", "unit", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["higher_is_better", "lower_is_better", "neutral"] }
      }
    }
  }
}
